{
  "name": "agentmux-desktop",
  "description": "Native Electron desktop application for the AgentMux multi-Agent terminal",
  "version": "0.1.2-rc.1",
  "author": "AgentMux contributors",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "lib/main.js",
  "files": [
    "lib/*.js"
  ],
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:electron --external:electron-updater --outfile=lib/main.js",
    "dev": "pnpm run build && electron . --project-root ../..",
    "start": "electron .",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dist:win": "pnpm run build && pnpm run prepare:runtime && electron-builder --win nsis --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron": "^35.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
